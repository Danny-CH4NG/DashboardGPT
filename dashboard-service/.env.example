# Copy to .env (same folder) if you need to change defaults. .env is git-ignored.
# Chat widget to load; leave empty to run the dashboard without chat.
CHAT_WIDGET_URL=http://localhost:4200/widget.js
# PORT=4100
# PUBLIC_URL=http://localhost:4100
# Where the component manifest comes from (default: dist/component-manifest.json from `npm run build`).
# MANIFEST_URL=https://frontend.example.com/component-manifest.json
# MANIFEST_REFRESH_SECONDS=30
# ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173
# FRAME_ANCESTORS='self' http://localhost:4200

{
  "name": "dashboard-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"cross-env MANIFEST_URL=http://localhost:5173/component-manifest.json tsx watch server.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server.ts",
    "manifest": "tsx scripts/emit-manifest.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.2",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@upstash/redis": "^1.41.0",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "echarts": "^6.1.0",
    "fastify": "^5.12.8",
    "maplibre-gl": "^5.24.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
